# 复制本文件为 .env.local 并填入真实值：
#   cp .env.example .env.local
# .env.local 已被 .gitignore 忽略，绝不会进 git。
#
# 安全约定：任何 sk- 开头的密钥都不许贴进对话、issue、截图。
# 万一泄露：去控制台吊销重发，光删文件没用（git 历史里还在）。

# ---------- 数据库（Neon Postgres，需开启 pgvector）----------
# 从 Neon 控制台复制。注意有两个地址：
#   -pooler  结尾 = 连接池地址，应用运行时用这个
#   不带 pooler = 直连地址，Prisma migrate 用这个
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# 直连地址，给 prisma migrate 用
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------- 硅基流动：Embedding + Rerank ----------
EMBED_API_KEY=""
EMBED_BASE_URL="https://api.siliconflow.cn/v1"
EMBED_MODEL="BAAI/bge-m3"          # 输出 1024 维，pgvector 建表按 1024
RERANK_MODEL="BAAI/bge-reranker-v2-m3"

# ---------- DeepSeek：LLM 生成 ----------
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
# deepseek-flash 是推理模型，默认会先"打草稿"（思考 token 照样计费）。
# RAG 问答场景建议传 thinking: { type: 'disabled' } 关掉，更快更省。
LLM_MODEL="deepseek-flash"

# ---------- NextAuth ----------
# 生成：openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
