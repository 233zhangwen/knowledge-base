# 复制本文件为 .env.local 并填入真实值：
#   cp .env.example .env.local
# .env.local 已被 .gitignore 忽略，绝不会进 git。
#
# 安全约定：任何 sk- 开头的密钥都不许贴进对话、issue、截图。
# 万一泄露：去控制台吊销重发，光删文件没用（git 历史里还在）。

# ---------- 数据库（Neon Postgres，需开启 pgvector）----------
# 从 Neon 控制台复制。注意有两个地址，用在不同地方：
#   DATABASE_URL（-pooler 结尾）= 连接池地址，应用运行时读写走这个
#   DIRECT_URL（不带 pooler）  = 直连地址，prisma migrate 走这个
#     —— 地址在 prisma7.config.ts 里读 DIRECT_URL，不在 schema 里
#     （Prisma 7 删掉了 schema 的 url/directUrl，也删掉了 config 的 directUrl）
# 复制时记得删掉 Neon 默认带的 &channel_binding=require，Node 驱动不认
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------- 硅基流动：Embedding + Rerank ----------
EMBED_API_KEY=""
EMBED_BASE_URL="https://api.siliconflow.cn/v1"
EMBED_MODEL="BAAI/bge-m3"          # 输出 1024 维，pgvector 建表按 1024
RERANK_MODEL="BAAI/bge-reranker-v2-m3"

# ---------- DeepSeek：LLM 生成 ----------
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
# deepseek-flash 是推理模型，默认会先"打草稿"（思考 token 照样计费）。
# RAG 问答场景建议传 thinking: { type: 'disabled' } 关掉，更快更省。
LLM_MODEL="deepseek-flash"

# ---------- 可观测（W13）----------
# 运维页 /admin 的访问白名单：只有登录邮箱与它一致才能看。
# 不配 = 该页整页 404（不是 403 —— 404 不告诉扫描器"这里有个东西"）。
ADMIN_EMAIL=""

# 日志级别：debug | info | warn | error，默认 info。
# 本地排查时设 debug 能看到会话复用、上下文条数这类高频流水。
LOG_LEVEL="info"

# 成本估算单价（元 / 百万 token）。不配则 /admin 只显示 token、不显示金额。
# 单价随模型与计费策略变化，自己按控制台当前价格维护，别抄别人的。
LLM_PRICE_IN_PER_M=""
LLM_PRICE_OUT_PER_M=""

# ---------- NextAuth v5 + GitHub OAuth ----------
# 生成：openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# 在 https://github.com/settings/developers 建 OAuth App 后拿到，
# 回调地址必须是 http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------- 本机网络（可选，仅国内开发环境）----------
# Node 的内置 fetch 不认 Windows 系统代理。GitHub OAuth 登录时，
# 浏览器能授权成功，但 Auth.js 在服务端拿 code 换 access_token 时直连
# github.com 会超时：CallbackRouteError / UND_ERR_CONNECT_TIMEOUT。
#
# 解法：配 HTTPS_PROXY，让 scripts/dev.mjs（npm run dev 的包装器）在启动
# Next 之前设好 NODE_USE_ENV_PROXY=1 —— Node 22.15+/24 原生支持这个开关，
# 会给 http 请求和内置 fetch 自动挂代理。零依赖。
#
# 关键点：这个开关只在 Node 进程启动那一刻读取，所以必须由外层进程设置，
#        写进 Next 内部的 instrumentation.ts 已经来不及（实测无效）。
#
# 不配置就什么都不发生 —— Vercel 生产环境没有也不需要这个变量，自动直连。
# 端口看你自己的代理软件（Clash 常见 7890、v2rayN 常见 10809）。
HTTPS_PROXY=""

# ── 对象存储驱动（storage.ts）──
# 未设置时：有 BLOB_READ_WRITE_TOKEN 走 Vercel Blob，否则走本地磁盘（仅本地开发）。
# serverless 平台（Netlify 等）文件系统只读，必须显式设为 db（原件存 Postgres ObjectFile 表）。
STORAGE_DRIVER=
