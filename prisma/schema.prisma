// 个人知识库问答 — 数据模型
//
// 说明：最初这里留了 4 处 TODO 作为练习（关系字段 / 向量字段 / 唯一约束 / 会话归属），
// 现已全部填写完毕并已 migrate 到远端 Neon。
// 保留 TODO 2 / 3 附近的思路注释，是因为它们记录的是"为什么这么声明"，删掉会丢信息。
// 之后每次改 schema 都要跑 migrate —— 不要手改远端表结构，否则本地迁移历史会对不上。

// Prisma 7 的变化：
//   1. generator 用 "prisma-client"（旧版是 "prisma-client-js"），且必须指定 output
//   2. 数据库连接地址不再写在这里，搬到根目录的 prisma7.config.ts
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 一、NextAuth v5（Auth.js）标准四张表
// 这四张是适配器要求的固定结构，不要自己发明，照抄官方模板即可。
// 只加了一个 createdAt 方便后面排查问题。
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  // 业务关系
  knowledgeBases KnowledgeBase[]
  conversations  Conversation[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ============================================================
// 二、业务表
// ============================================================

model KnowledgeBase {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents     Document[]
  conversations Conversation[]
}

model Document {
  id         String   @id @default(cuid())
  title      String
  sourceType String // pdf | md | txt
  sizeBytes  Int?
  status     String   @default("pending") // pending | processing | ready | failed
  error      String?
  createdAt  DateTime @default(now())

  kbId String
  kb   KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  /**
   * 原件在对象存储里的位置（key）。
   *
   * ⚠️ 问答链路**永远不读它** —— 检索只读 Postgres 里的 Chunk。
   * 它只在两件事上用到：重新切片（W6 换了策略要重跑）、用户下载原件。
   * 这个解耦是故意的：对象存储挂了 / 欠费了 / 国内访问不通，问答照跑。
   */
  storageKey String?

  /**
   * 解析出来的纯文本。
   *
   * 为什么不留给 W3 切片时再去对象存储现拉？因为那样切片的可用性就
   * 绑死在对象存储上了。存进 Postgres 之后，切片只需要 DB —— 和上面同一条思路。
   */
  content String?

  chunks Chunk[]
}

model Chunk {
  id         String @id @default(cuid())
  content    String
  chunkIndex Int

  // TODO 2：核心字段 —— 1024 维向量怎么在 Prisma 里声明？
  //   Prisma 没有原生的 vector 类型（bge-m3 输出 1024 维）。
  //   提示：Prisma 有个 Unsupported() 可以声明数据库原生类型。
  //   注意两个坑：
  //     a) 字段是可选还是必填？想想「文档先入库、向量后回填」这个顺序
  //     b) Unsupported 类型的字段，Prisma Client 读写不了，
  //        写入和检索都得靠 $queryRaw —— 这会影响 W3/W4 的代码写法
  //
  //   embedding ???
  embedding Unsupported("vector(1024)")?


  // TODO 3：同一篇文档里，chunkIndex 不应该重复。
  //   这个约束怎么声明？
  //
  //   @@unique([???])
  @@unique([documentId, chunkIndex])


  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // TODO 4：会话同时挂在「知识库」和「用户」下面。
  //   两个关系的级联删除策略一样吗？
  //   想一个场景：知识库被删了，但用户账号还在 —— 这个会话该留还是该删？
  //   反过来：用户销号了，会话该留还是该删？
  //
  //   kbId   String
  //   kb     KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: ???)
  //   userId String
  //   user   User @relation(fields: [userId], references: [id], onDelete: ???)
  kbId   String
  kb     KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]
}

model Message {
  id      String @id @default(cuid())
  role    String // user | assistant
  content String

  /**
   * 引用溯源：**存快照，不存外键**。
   *
   * 存的是这次回答当时真正喂给 Prompt 的那几条（含片段全文），不是 chunkId。
   * 理由和 W4 的 B2 是同一条：外键查到的是"当前"库里的 chunk，
   * 而这期间文档可能已被删、已被重建索引、切片已重排。
   * 只存外键的话，同一个 bug 只是被推迟到三个月后发作（spec A3）。
   */
  citations Json? // 快照：[{chunkIndex, documentId, documentTitle, similarity, content}]

  /**
   * 这条 assistant 消息是怎么结束的（W5 新增，spec D4）。
   *
   *   complete = 正常生成完
   *   stopped  = 用户按了「停止生成」，内容可能只有半截
   *
   * ⚠️ 注意这里**故意没有 failed**：生成失败时 assistant 消息压根不落库（spec D1），
   * 历史里留下的是一条没有回答的 user 消息，由 UI 侧推断出"未完成"（spec D5）。
   * 少一个状态比多一个状态好 —— 存下来就要维护它的语义，而它带来不了任何新信息。
   */
  finishReason String @default("complete") // complete | stopped

  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // 每次打开会话都要「按会话取最近若干条」，这个复合索引让 take + orderBy 走索引
  @@index([conversationId, createdAt])
}
