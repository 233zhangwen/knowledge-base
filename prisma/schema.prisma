// 个人知识库问答 — 数据模型
//
// 说明：最初这里留了 4 处 TODO 作为练习（关系字段 / 向量字段 / 唯一约束 / 会话归属），
// 现已全部填写完毕并已 migrate 到远端 Neon。
// 保留 TODO 2 / 3 附近的思路注释，是因为它们记录的是"为什么这么声明"，删掉会丢信息。
// 之后每次改 schema 都要跑 migrate —— 不要手改远端表结构，否则本地迁移历史会对不上。

// Prisma 7 的变化：
//   1. generator 用 "prisma-client"（旧版是 "prisma-client-js"），且必须指定 output
//   2. 数据库连接地址不再写在这里，搬到根目录的 prisma7.config.ts
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 一、NextAuth v5（Auth.js）标准四张表
// 这四张是适配器要求的固定结构，不要自己发明，照抄官方模板即可。
// 只加了一个 createdAt 方便后面排查问题。
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  // 业务关系
  knowledgeBases KnowledgeBase[]
  conversations  Conversation[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ============================================================
// 二、业务表
// ============================================================

model KnowledgeBase {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents     Document[]
  conversations Conversation[]
}

model Document {
  id         String   @id @default(cuid())
  title      String
  sourceType String // pdf | md | txt
  sizeBytes  Int?
  status     String   @default("pending") // pending | processing | ready | failed
  error      String?
  createdAt  DateTime @default(now())

  kbId String
  kb   KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  /**
   * 原件在对象存储里的位置（key）。
   *
   * ⚠️ 问答链路**永远不读它** —— 检索只读 Postgres 里的 Chunk。
   * 它只在两件事上用到：重新切片（W6 换了策略要重跑）、用户下载原件。
   * 这个解耦是故意的：对象存储挂了 / 欠费了 / 国内访问不通，问答照跑。
   */
  storageKey String?

  /**
   * 解析出来的纯文本。
   *
   * 为什么不留给 W3 切片时再去对象存储现拉？因为那样切片的可用性就
   * 绑死在对象存储上了。存进 Postgres 之后，切片只需要 DB —— 和上面同一条思路。
   */
  content String?

  /**
   * W14：入库时扫到疑似指令性文本（「忽略以上指令」「system prompt」等）的时间戳。
   *
   * 只标记、不阻断 —— 安全教材和 AI 论文天然含这些句子，拒收会误伤真实文档。
   * 标记的用途是让检索结果在喂给模型时多一行提醒（见 src/lib/untrusted.ts 的 fenceChunk），
   * 以及给 /admin 留一条审计线索。NULL = 未发现可疑文本。
   */
  suspiciousAt DateTime?

  chunks Chunk[]
}

/// 对象存储的数据库落地（storage.ts 的 dbStorage 驱动使用）。
///
/// 为什么要有这张表：serverless 平台（Netlify / Vercel 函数）的文件系统是
/// 只读的，storage.ts 的本地磁盘驱动在它们上面必然 ENOENT（生产实测
/// `mkdir '/var/task/.storage'` 失败）。BYTEA 存字节：单文件上限 4MB
/// （应用层 MAX_FILE_SIZE），远在 Postgres 大字段舒适区之内。
///
/// 为什么不直接用平台对象存储（Netlify Blobs / Vercel Blob）：
/// 那会把存储绑死在某一家平台，换平台就得迁移。Postgres 两边通吃，
/// 且和 Chunk 同一个可用性域 —— 备份、迁移只多一张表。
///
/// key 与 Document.storageKey 对应，无外键（对象清理走 removeQuietly
/// 的"尽力删除"语义，同磁盘驱动；数据库记录删除不该被存储层卡死）。
model ObjectFile {
  key         String   @id
  bytes       Bytes
  contentType String?
  sizeBytes   Int
  createdAt   DateTime @default(now())
}

model Chunk {
  id         String @id @default(cuid())
  content    String
  chunkIndex Int

  // TODO 2：核心字段 —— 1024 维向量怎么在 Prisma 里声明？
  //   Prisma 没有原生的 vector 类型（bge-m3 输出 1024 维）。
  //   提示：Prisma 有个 Unsupported() 可以声明数据库原生类型。
  //   注意两个坑：
  //     a) 字段是可选还是必填？想想「文档先入库、向量后回填」这个顺序
  //     b) Unsupported 类型的字段，Prisma Client 读写不了，
  //        写入和检索都得靠 $queryRaw —— 这会影响 W3/W4 的代码写法
  //
  //   embedding ???
  embedding Unsupported("vector(1024)")?


  // TODO 3：同一篇文档里，chunkIndex 不应该重复。
  //   这个约束怎么声明？
  //
  //   @@unique([???])
  @@unique([documentId, chunkIndex])


  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // TODO 4：会话同时挂在「知识库」和「用户」下面。
  //   两个关系的级联删除策略一样吗？
  //   想一个场景：知识库被删了，但用户账号还在 —— 这个会话该留还是该删？
  //   反过来：用户销号了，会话该留还是该删？
  //
  //   kbId   String
  //   kb     KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: ???)
  //   userId String
  //   user   User @relation(fields: [userId], references: [id], onDelete: ???)
  kbId   String
  kb     KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]
}

model Message {
  id      String @id @default(cuid())
  role    String // user | assistant
  content String

  /**
   * 引用溯源：**存快照，不存外键**。
   *
   * 存的是这次回答当时真正喂给 Prompt 的那几条（含片段全文），不是 chunkId。
   * 理由和 W4 的 B2 是同一条：外键查到的是"当前"库里的 chunk，
   * 而这期间文档可能已被删、已被重建索引、切片已重排。
   * 只存外键的话，同一个 bug 只是被推迟到三个月后发作（spec A3）。
   */
  citations Json? // 快照：[{chunkIndex, documentId, documentTitle, similarity, content}]

  /**
   * 这条 assistant 消息是怎么结束的（W5 新增，spec D4）。
   *
   *   complete = 正常生成完
   *   stopped  = 用户按了「停止生成」，内容可能只有半截
   *
   * ⚠️ 注意这里**故意没有 failed**：生成失败时 assistant 消息压根不落库（spec D1），
   * 历史里留下的是一条没有回答的 user 消息，由 UI 侧推断出"未完成"（spec D5）。
   * 少一个状态比多一个状态好 —— 存下来就要维护它的语义，而它带来不了任何新信息。
   */
  finishReason String @default("complete") // complete | stopped

  /**
   * 每答成本（W13 D 组）——全部可空，老数据不回填。
   *
   * 为什么要落库而不是只打日志：Agent 一次回答可能跑 1~5 个 LLM 步，
   * 成本是 W9 实测的 in≈2.2x / out≈5.5x（相对纯 RAG）。这个倍率要能被持续观测，
   * 否则"Agent 化更贵"只是 W9 那一次的结论，而不是能天天看的数字。
   * 可空是因为 stopped（用户中断）时 finish 事件可能没发，拿不到 usage。
   */
  inputTokens  Int?
  outputTokens Int?
  steps        Int? // 本次回答跑了几步（含未调工具的收尾步）
  latencyMs    Int? // 请求进来到流结束的墙钟时间

  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // 每次打开会话都要「按会话取最近若干条」，这个复合索引让 take + orderBy 走索引
  @@index([conversationId, createdAt])
}

/**
 * 错误记录（W13 C 组，决策①自建）。
 *
 * 为什么合并重复而不是一错一行：一次故障会刷出成百上千条同样的错，
 * 不合并的话查看页第一天就被淹没，等于没有。fingerprint 相同的只累加 count。
 *
 * 为什么自己建表而不用 Sentry：见 ACCEPTANCE-W13 决策① —— 上报通道本身不能是不稳的，
 * 而海外服务在本地网络下确实不稳（W9 实测）。自建还能顺手做个成本统计页。
 */
model ErrorLog {
  id String @id @default(cuid())

  level   String // error | warn
  event   String // 点分事件名，与 log.ts 的 evt 一致，方便两边对账
  message String
  stack   String?
  path    String? // 出错的页面/接口

  /**
   * 去重指纹：sha1(event + message 前 200 字 + path)。
   * ⚠️ 故意**不含时间、不含用户 id、不含随机 id** —— 任何随请求变化的东西进来，
   * 去重就失效了（同一个 bug 每行都算"新错误"）。
   */
  fingerprint String @unique

  count     Int      @default(1)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@index([lastSeen])
}
