// 个人知识库问答 — 数据模型
//
// 说明：最初这里留了 4 处 TODO 作为练习（关系字段 / 向量字段 / 唯一约束 / 会话归属），
// 现已全部填写完毕并已 migrate 到远端 Neon。
// 保留 TODO 2 / 3 附近的思路注释，是因为它们记录的是"为什么这么声明"，删掉会丢信息。
// 之后每次改 schema 都要跑 migrate —— 不要手改远端表结构，否则本地迁移历史会对不上。

// Prisma 7 的变化：
//   1. generator 用 "prisma-client"（旧版是 "prisma-client-js"），且必须指定 output
//   2. 数据库连接地址不再写在这里，搬到根目录的 prisma7.config.ts
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 一、NextAuth v5（Auth.js）标准四张表
// 这四张是适配器要求的固定结构，不要自己发明，照抄官方模板即可。
// 只加了一个 createdAt 方便后面排查问题。
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  // 业务关系
  //
  // W19：这里原本是 knowledgeBases / conversations 两个直接关系。
  // 租户边界从「用户」抬到「组织」之后，用户不再直接拥有业务数据，
  // 而是通过 Membership 加入组织 —— 关系挂在 Membership 上。
  //
  // 注意：用户销号不应该带走组织的数据。组织是长期实体，成员是流动的。
  memberships Membership[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ============================================================
// 二、租户（W19）
//
// 为什么需要这一层：W1–W18 的数据边界是「用户本人」—— KnowledgeBase.userId
// 既是"谁能访问"也是"谁建的"。两个语义混在一个字段里，等要做多人协作时
// 就没有字段能回答"谁建的"了。
//
// Organization 是**计费与隔离的单位**，Membership 是**人属于哪个组织**。
// 一个用户可以属于多个组织（转岗、外包、兼职），所以中间表是必需的。
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  memberships    Membership[]
  knowledgeBases KnowledgeBase[]
  conversations  Conversation[]

  // W21 会在这里挂 usageRecords（按月问答次数）。
  // 现在不建表：配额还没有任何逻辑，建一张空表只会让人以为已经做了。
}

/// 用户 × 组织。role 先只有 owner（W19 只做底座，W20 加 member 与权限矩阵）。
model Membership {
  id     String @id @default(cuid())
  role   String @default("owner") // owner | member（W20）
  userId String
  orgId  String
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // 同一个人在同一组织只能有一条成员记录。
  // 没有这个约束，"邀请同一个人两次"就会产生两条 owner，权限判断开始靠运气。
  @@unique([userId, orgId])

  // 每次请求都要走"当前用户 → 他的组织"这一步，这个索引是热路径。
  @@index([orgId])
}

// ============================================================
// 三、业务表
// ============================================================

model KnowledgeBase {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /**
   * 权限字段：能不能访问。所有查询条件都用它。
   *
   * W19 之前这里是 userId（一个字段同时表达"谁能看"和"谁建的"）。
   * 现在拆成两个：orgId 管访问，createdBy 管审计。
   */
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /**
   * 归属字段：谁建的。**故意不做外键**。
   *
   * 理由：用户销号后组织的数据要留着（组织是长期实体，成员是流动的），
   * 做外键就只能 SetNull，那样连"谁建的"都丢了；做 Cascade 更糟，会把库删掉。
   * 留一个可能悬空的字符串，比丢信息好 —— 和 Document.supersededBy 同一个取舍。
   */
  createdBy String

  documents     Document[]
  conversations Conversation[]
}

model Document {
  id         String   @id @default(cuid())
  title      String
  sourceType String // pdf | md | txt
  sizeBytes  Int?
  status     String   @default("pending") // pending | processing | ready | failed
  error      String?
  createdAt  DateTime @default(now())

  kbId String
  kb   KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  /**
   * 原件在对象存储里的位置（key）。
   *
   * ⚠️ 问答链路**永远不读它** —— 检索只读 Postgres 里的 Chunk。
   * 它只在两件事上用到：重新切片（W6 换了策略要重跑）、用户下载原件。
   * 这个解耦是故意的：对象存储挂了 / 欠费了 / 国内访问不通，问答照跑。
   */
  storageKey String?

  /**
   * 解析出来的纯文本。
   *
   * 为什么不留给 W3 切片时再去对象存储现拉？因为那样切片的可用性就
   * 绑死在对象存储上了。存进 Postgres 之后，切片只需要 DB —— 和上面同一条思路。
   */
  content String?

  /**
   * W14：入库时扫到疑似指令性文本（「忽略以上指令」「system prompt」等）的时间戳。
   *
   * 只标记、不阻断 —— 安全教材和 AI 论文天然含这些句子，拒收会误伤真实文档。
   * 标记的用途是让检索结果在喂给模型时多一行提醒（见 src/lib/untrusted.ts 的 fenceChunk），
   * 以及给 /admin 留一条审计线索。NULL = 未发现可疑文本。
   */
  suspiciousAt DateTime?

  /**
   * W17：从正文抽出来的生效日期，**`YYYY-MM-DD` 字符串，不是 DateTime**。
   *
   * 为什么不是 DateTime：第一版用了 DateTime，Prisma 映射成 `TIMESTAMP(3)`（不带时区），
   * 写入按 UTC 字面值存、读回按本地 +08 解释 —— 2026-01-01 变成 2025-12-31，差一天。
   * 但根因不是时区，是**类型选错了**：生效日期的语义是"某一天"，没有时分秒，也就没有时区。
   * 字符串零时区问题、ISO 8601 的字典序等于日期序、显示不用转换。
   *
   * 为什么必须落到文档级：命中问题的块（C#2 婚假）里没有日期，日期在文末那句里。
   * 存下来，检索时才能把它"贴"到每一个命中的块上。
   *
   * 可空。抽不到就是 null —— 不能拿「创建时间」之类的近似值顶上，
   * 那会让模型把"我不知道"当成"这是新文件"。
   */
  effectiveFrom String?

  /**
   * W17：文档内的 H1 标题（`# 星海科技员工手册（2024 版）`）。
   *
   * 为什么不直接用 title：title 是文件名，带着 `E-` 前缀和 `.md` 后缀 ——
   * 那是测试脚手架的痕迹，对模型是纯噪声，对用户是刺眼的杂物。
   * 而且废止声明里引用的正是文档内标题（`《员工手册（2024 版）》`），
   * 对齐和展示共用同一个来源，才不会出现"对齐用的是 A、显示的是 B"。
   */
  docTitle String?

  /**
   * W17：废止这份文档的那份文档 —— 存它的 `Document.title`，**不是外键**。
   *
   * 为什么不用外键：废止声明里的名字可能指向库里根本没有的文件
   * （《员工手册（2021 版）》就不在库），外键会在回填时直接失败。
   * 代价是文档改名后这个值会悬空 —— 本项目没有重命名功能，先接受，
   * 写在这里是为了让下一个改动的人知道这个取舍不是忘了。
   *
   * 语义约定：非空 = 已被取代；NULL = 不知道或仍现行。区分这两者要看 effectiveFrom。
   */
  supersededBy String?

  /**
   * W17：本文档声明的「我废止了哪些文件」，书名号内的原始写法。
   *
   * 为什么要把这个中间结果存下来，而不是每次从 content 现抽：
   * `supersededBy` 是**反向关系**，要算它必须遍历同库所有文档的声明。新上传一篇
   * 2026 版手册时，被废止的那份可能是几年前上传的，必须重算全库。
   * 若重算时读 content（每篇几 KB~几 MB），一次上传就要把整个库拉进内存；
   * 而这里只需要 4 个短字段，几十篇也不到 1KB。
   *
   * 内容是对齐**之前**的原始写法（`员工手册（2024 版）`），对齐结果不进库 ——
   * 因为对齐依赖同库文档集合，存下来会随别的文档增删而过期。
   */
  supersedesRaw String[] @default([])

  chunks Chunk[]
}

/// 对象存储的数据库落地（storage.ts 的 dbStorage 驱动使用）。
///
/// 为什么要有这张表：serverless 平台（Netlify / Vercel 函数）的文件系统是
/// 只读的，storage.ts 的本地磁盘驱动在它们上面必然 ENOENT（生产实测
/// `mkdir '/var/task/.storage'` 失败）。BYTEA 存字节：单文件上限 4MB
/// （应用层 MAX_FILE_SIZE），远在 Postgres 大字段舒适区之内。
///
/// 为什么不直接用平台对象存储（Netlify Blobs / Vercel Blob）：
/// 那会把存储绑死在某一家平台，换平台就得迁移。Postgres 两边通吃，
/// 且和 Chunk 同一个可用性域 —— 备份、迁移只多一张表。
///
/// key 与 Document.storageKey 对应，无外键（对象清理走 removeQuietly
/// 的"尽力删除"语义，同磁盘驱动；数据库记录删除不该被存储层卡死）。
model ObjectFile {
  key         String   @id
  bytes       Bytes
  contentType String?
  sizeBytes   Int
  createdAt   DateTime @default(now())
}

model Chunk {
  id         String @id @default(cuid())
  content    String
  chunkIndex Int

  // TODO 2：核心字段 —— 1024 维向量怎么在 Prisma 里声明？
  //   Prisma 没有原生的 vector 类型（bge-m3 输出 1024 维）。
  //   提示：Prisma 有个 Unsupported() 可以声明数据库原生类型。
  //   注意两个坑：
  //     a) 字段是可选还是必填？想想「文档先入库、向量后回填」这个顺序
  //     b) Unsupported 类型的字段，Prisma Client 读写不了，
  //        写入和检索都得靠 $queryRaw —— 这会影响 W3/W4 的代码写法
  //
  //   embedding ???
  embedding Unsupported("vector(1024)")?


  // TODO 3：同一篇文档里，chunkIndex 不应该重复。
  //   这个约束怎么声明？
  //
  //   @@unique([???])
  @@unique([documentId, chunkIndex])


  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // TODO 4：会话同时挂在「知识库」和「用户」下面。
  //   两个关系的级联删除策略一样吗？
  //   想一个场景：知识库被删了，但用户账号还在 —— 这个会话该留还是该删？
  //   反过来：用户销号了，会话该留还是该删？
  //
  //   kbId   String
  //   kb     KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: ???)
  //   userId String
  //   user   User @relation(fields: [userId], references: [id], onDelete: ???)
  kbId   String
  kb     KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  /**
   * 冗余的租户字段（W19）。kbId 已经隐含了组织，为什么还要存一份？
   *
   * 因为查询要**不 join 就能过滤**：列表页 where 是 `{ orgId, kbId }`，
   * 两个条件都在 Conversation 自己的行上，走索引即可。只靠 kbId → kb.orgId
   * 意味着每处判断权限都要 join，而 join 写法每处都可能漏一个条件 ——
   * 直白地冗余一列，比依赖关系推导更难写错。
   *
   * 代价（如实记账）：kb 换组织时这里会不同步。本项目没有「转移知识库」功能，
   * 真要做时必须在同一事务里改两处。**冗余字段的代价永远是"两处要一起改"。**
   */
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// 谁发起的这个会话（审计，无外键，理由同 KnowledgeBase.createdBy）。
  createdBy String

  messages Message[]
}

model Message {
  id      String @id @default(cuid())
  role    String // user | assistant
  content String

  /**
   * 引用溯源：**存快照，不存外键**。
   *
   * 存的是这次回答当时真正喂给 Prompt 的那几条（含片段全文），不是 chunkId。
   * 理由和 W4 的 B2 是同一条：外键查到的是"当前"库里的 chunk，
   * 而这期间文档可能已被删、已被重建索引、切片已重排。
   * 只存外键的话，同一个 bug 只是被推迟到三个月后发作（spec A3）。
   */
  citations Json? // 快照：[{chunkIndex, documentId, documentTitle, similarity, content}]

  /**
   * 这条 assistant 消息是怎么结束的（W5 新增，spec D4）。
   *
   *   complete = 正常生成完
   *   stopped  = 用户按了「停止生成」，内容可能只有半截
   *
   * ⚠️ 注意这里**故意没有 failed**：生成失败时 assistant 消息压根不落库（spec D1），
   * 历史里留下的是一条没有回答的 user 消息，由 UI 侧推断出"未完成"（spec D5）。
   * 少一个状态比多一个状态好 —— 存下来就要维护它的语义，而它带来不了任何新信息。
   */
  finishReason String @default("complete") // complete | stopped

  /**
   * 每答成本（W13 D 组）——全部可空，老数据不回填。
   *
   * 为什么要落库而不是只打日志：Agent 一次回答可能跑 1~5 个 LLM 步，
   * 成本是 W9 实测的 in≈2.2x / out≈5.5x（相对纯 RAG）。这个倍率要能被持续观测，
   * 否则"Agent 化更贵"只是 W9 那一次的结论，而不是能天天看的数字。
   * 可空是因为 stopped（用户中断）时 finish 事件可能没发，拿不到 usage。
   */
  inputTokens  Int?
  outputTokens Int?
  steps        Int? // 本次回答跑了几步（含未调工具的收尾步）
  latencyMs    Int? // 请求进来到流结束的墙钟时间

  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // 每次打开会话都要「按会话取最近若干条」，这个复合索引让 take + orderBy 走索引
  @@index([conversationId, createdAt])
}

/**
 * 错误记录（W13 C 组，决策①自建）。
 *
 * 为什么合并重复而不是一错一行：一次故障会刷出成百上千条同样的错，
 * 不合并的话查看页第一天就被淹没，等于没有。fingerprint 相同的只累加 count。
 *
 * 为什么自己建表而不用 Sentry：见 ACCEPTANCE-W13 决策① —— 上报通道本身不能是不稳的，
 * 而海外服务在本地网络下确实不稳（W9 实测）。自建还能顺手做个成本统计页。
 */
model ErrorLog {
  id String @id @default(cuid())

  level   String // error | warn
  event   String // 点分事件名，与 log.ts 的 evt 一致，方便两边对账
  message String
  stack   String?
  path    String? // 出错的页面/接口

  /**
   * 去重指纹：sha1(event + message 前 200 字 + path)。
   * ⚠️ 故意**不含时间、不含用户 id、不含随机 id** —— 任何随请求变化的东西进来，
   * 去重就失效了（同一个 bug 每行都算"新错误"）。
   */
  fingerprint String @unique

  count     Int      @default(1)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@index([lastSeen])
}
